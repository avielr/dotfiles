# Secrets template.
# Copy this file to ~/.secrets/env and fill in real values:
#   mkdir -p ~/.secrets && cp secrets/env.example ~/.secrets/env && chmod 600 ~/.secrets/env
# NEVER commit the real ~/.secrets/env. .zshrc sources it automatically if present.

export ANTHROPIC_API_KEY="sk-ant-..."
export GEMINI_API_KEY="AIza..."

# Optional, add as needed:
# export OPENAI_API_KEY="sk-..."
# export OPENROUTER_API_KEY="sk-or-..."
